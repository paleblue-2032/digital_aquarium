// .vscode/settings.json
{
    // Python関連の設定
    "python.analysis.typeCheckingMode": "basic",
    "python.linting.pylintEnabled": true,
    "python.linting.enabled": true,
    "python.formatting.provider": "black", // Blackフォーマッターを使用
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter", // Blackをデフォルトに
        "editor.formatOnSave": true, // 保存時に自動フォーマット
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit" // import文を自動整理
        }
    },
    // JavaScript/HTML/CSS関連の設定 (Prettier)
    "editor.formatOnSave": true, // 保存時に自動フォーマット (全体設定)
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "prettier.singleQuote": true, // JSでシングルクォートを使用 (好みで)
    // ファイル設定
    "files.associations": {
        "*.ino": "cpp" // ArduinoファイルをC++として認識
    },
    "files.encoding": "utf8",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true
}